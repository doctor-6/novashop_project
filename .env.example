# Copy this file to ".env" and adjust the values if needed.
# All values have safe local defaults, so a .env file is optional.

# TCP port for the web server
PORT=3000

# Demo admin password for the classroom demo.
# WARNING: this is a demo credential, not real security.
ADMIN_PASSWORD=1234

# Secret used to sign the admin session cookie.
# Generate your own with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Maximum accepted product image size in bytes (default 5 MB = 5,000,000 bytes)
MAX_IMAGE_BYTES=5000000
